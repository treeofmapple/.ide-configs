package com.tom.service.datagen.service;

import org.springframework.stereotype.Component;

import com.tom.service.datagen.common.GenerateData;
import com.tom.service.datagen.common.IdGenerator;
import com.tom.service.datagen.dto.SchoolRequest;
import com.tom.service.datagen.exception.AlreadyExistsException;
import com.tom.service.datagen.model.school.Alunos;
import com.tom.service.datagen.model.school.Avaliacoes;
import com.tom.service.datagen.model.school.Disciplinas;
import com.tom.service.datagen.model.school.Matriculas;
import com.tom.service.datagen.model.school.Notas;
import com.tom.service.datagen.model.school.Turmas;

import lombok.extern.log4j.Log4j2;

@Log4j2
@Component
public class SchoolUtils extends GenerateData {

	private short alunos, disciplinas, turmas, matriculas;

	public Alunos generateSingleAluno() {
		Alunos alunos = new Alunos();
		alunos.setId(null);
		alunos.setMatricula(null);
		alunos.setNome(null);
		return alunos;
	}

	public Disciplinas generateSingleDisciplina() {
		Disciplinas disciplinas = new Disciplinas();
		
		return disciplinas;
	}

	public Turmas generateSingleTurma() {
		Turmas turmas = new Turmas();
		return turmas;
	}

	public Matriculas generateSingleMatricula() {
		Matriculas matriculas = new Matriculas();
		return matriculas;
	}

	public Avaliacoes generateSingleAvaliacoes() {
		Avaliacoes avaliacoes = new Avaliacoes();
		return avaliacoes;
	}

	public Notas generateSingleNotas() {
		Notas notas = new Notas();
		return notas;
	}

	public void setVariables(SchoolRequest request) {
		log.info("");
		alunos = request.alunos();
		disciplinas = request.disciplina();
		turmas = request.turmas();
		matriculas = request.matriculas();
	}

}
