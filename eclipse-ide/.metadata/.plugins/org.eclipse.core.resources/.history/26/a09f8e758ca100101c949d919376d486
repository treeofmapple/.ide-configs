services:
  ofertadisciplina:
    build: .
    container_name: ofertadisciplina
    restart: unless-stopped
    depends_on:
      - postgres
      - redis
    ports:
      - "${SERVER_PORT}:8081"
    env_file:
      - .env
    
  postgres:
    image: postgres:16.3-alpine
    container_name: postgresql-shortener
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_DATABASE}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "${DB_EXTERNAL_PORT}:5432"
    env_file:
      - .env
      
volumes:
  postgres_data:
    driver: local
