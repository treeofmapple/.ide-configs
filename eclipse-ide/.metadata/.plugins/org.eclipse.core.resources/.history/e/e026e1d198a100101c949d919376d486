package ucsal.oferta.repository;

import java.util.HashMap;
import java.util.Map;
import java.util.Optional;

import org.assertj.core.api.Assertions;
import org.junit.jupiter.api.AfterAll;
import org.junit.jupiter.api.MethodOrderer;
import org.junit.jupiter.api.Order;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.TestInstance;
import org.junit.jupiter.api.TestMethodOrder;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.security.crypto.password.PasswordEncoder;

import net.datafaker.Faker;
import net.datafaker.providers.base.Text;
import ucsal.oferta.security.model.User;
import ucsal.oferta.security.repository.UserRepository;
import ucsal.oferta.testcontainers.RepositoryTest;

@DataJpaTest
@PostgresDataTest
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
@TestInstance(TestInstance.Lifecycle.PER_CLASS)
public class UserRepositoryTest extends RepositoryTest {

	@Autowired
	private UserRepository repository;

	@Autowired
	private PasswordEncoder encoder;

	@Autowired
	private Faker faker;
	
	@Test
	@Order(1)
	void createUserTest() {
		var dataForTest = generateAnUser();

		Integer userId = (Integer) dataForTest.get("id");
		Assertions.assertThat(userId).isNotNull();
	}

	@Test
	@Order(2)
	void createUserAndFind() {
		var dataForTest = generateAnUser();

		Integer userId = (Integer) dataForTest.get("id");
		Assertions.assertThat(userId).isNotNull();

		Optional<User> found = repository.findById(userId);
		Assertions.assertThat(found).isPresent();
	}

	@Test
	@Order(3)
	void findUserCreated() {
		var dataForTest = generateAnUser();

		Integer userId = (Integer) dataForTest.get("id");
		String expectedUsername = (String) dataForTest.get("username");
		String expectedPassword = (String) dataForTest.get("password");

		Optional<User> found = repository.findById(userId);

		Assertions.assertThat(found).isPresent();
		found.ifPresent(user -> {
			Assertions.assertThat(user.getUsername()).isEqualTo(expectedUsername);
			Assertions.assertThat(user.getPassword()).isEqualTo(expectedPassword);
		});
	}

	@Test
	@Order(4)
	void updateCreatedUser() {
		var dataForTest = generateAnUser();
		Integer userId = (Integer) dataForTest.get("id");

		String newUsername = faker.name().femaleFirstName();

		Optional<User> userToUpdate = repository.findById(userId);
		Assertions.assertThat(userToUpdate).isPresent();

		User updatedUser = userToUpdate.get();
		updatedUser.setUsername(newUsername);
		repository.save(updatedUser);

		Optional<User> foundUpdated = repository.findById(userId);
		Assertions.assertThat(foundUpdated).isPresent();
		Assertions.assertThat(foundUpdated.get().getUsername()).isEqualTo(newUsername);
	}

	@Test
	@Order(5)
	void deleteCreatedUser() {
		var dataForTest = generateAnUser();
		Integer userId = (Integer) dataForTest.get("id");

		repository.deleteById(userId);

		Optional<User> foundAfterDelete = repository.findById(userId);
		Assertions.assertThat(foundAfterDelete).isNotPresent();
	}

	@AfterAll
	void clearAllData() {
		repository.deleteAll();
	}

	private Map<String, Object> generateAnUser() {
		var user = createUser();
		var savedUser = repository.save(user);
		Map<String, Object> userData = new HashMap<>();
		userData.put("id", savedUser.getId());
		userData.put("username", savedUser.getUsername());
		userData.put("password", savedUser.getPassword());
		return userData;
	}

	private User createUser() {
		return new User(null, faker.name().maleFirstName(),
				encoder.encode(faker.text().text(Text.TextSymbolsBuilder.builder().len(8).build())));
	}

}
