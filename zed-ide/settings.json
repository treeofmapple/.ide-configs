{
  "edit_predictions": {
    "ollama": {
      "model": "qwen2.5-coder:14b"
    },
    "open_ai_compatible_api": {
      "model": ""
    },
    "provider": "ollama"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "qwen3.5-coder:14b",
          "max_tokens": 8192,
        },
      ],
    },
  },

  //#"terminal": {
  //},
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "minimal",
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:14b",
      "enable_thinking": false
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Cappone (eclipse)",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },

  "ui_font_size": 16,
  "buffer_font_size": 16,

  "format_on_save": "off",

  "project_panel": {
    "hide_hidden": false,
    "dock": "right",
    "auto_fold_dirs": true,
    "folder_icons": true,
    "indent_guides": {
      "show": "always",
    },
  },

  "disable_ai": true,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },

  "file_types": {
    "Java": ["java"],
    "HTML": ["html"],
  },

  "languages": {
    "Rust": {
      "format_on_save": "off",
    },
    "SCSS": {
      "language_servers": ["scss-lsp", "tailwindcss-language-server"],
    },
    "Angular": {
      "language_servers": [
        "tailwindcss-language-server",
        "vscode-html-language-server",
        "emmet-language-server",
        "angular",
      ],
      "completions": {
        "lsp": true,
      },
      "formatter": "prettier",
    },
    "JavaScript": {
      "language_servers": ["vtsls", "tailwindcss-language-server", "eslint"],
      "formatter": "prettier",
    },
    "TypeScript": {
      "language_servers": ["vtsls", "tailwindcss-language-server", "eslint"],
      "formatter": "prettier",
    },
    "TSX": {
      "language_servers": ["vtsls", "tailwindcss-language-server", "eslint"],
      "formatter": "prettier",
    },
  },

  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--compile-commands-dir=build",
          "--all-scopes-completion",
          "--completion-style=detailed",
          "--header-insertion=never",
          "--background-index",
          "-clang-tidy",
        ],
      },
      "initialization_options": {
        "fallbackFlags": ["-std=c++20"],
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "angular": {
      "initialization_options": {
        "angularCompilerOptions": {
          "strictTemplates": true,
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "clsx"],
        "tailwindCSS": {
          "includeLanguages": {
            "angular": "html",
            "html": "html",
            "javascript": "javascript",
            "javascriptreact": "javascriptreact",
            "typescript": "typescript",
            "typescriptreact": "typescriptreact",
          },
          "experimental": {
            "classRegex": [
              "\\[ngClass\\]=\"([^\"]*)\"",
              "class=\"([^\"]*)\"",
              "className=\"([^\"]*)\"",
            ],
          },
          "validate": true,
          "lint": {
            "cssConflict": "warning",
            "invalidApply": "error",
            "invalidScreen": "error",
            "invalidVariant": "error",
            "recommendedVariantOrder": "warning",
          },
        },
      },
    },
    "jdtls": {
      "binary": {
        "path": "/home/pogeku/.tools/jdtls/bin/jdtls",
        "arguments": [
          "--jvm-arg=-javaagent:/home/pogeku/.tools/lombok/lombok.jar",
        ],
      },
      "initialization_options": {
        "settings": {
          "java": {
            "initialization_options": {
              "settings": {
                "java": {
                  "project": {
                    "sourcePaths": ["src"],
                  },
                },
              },
            },
            "errors": {
              "incompleteClasspath": {
                "severity": "warning",
              },
            },
            "configuration": {
              "updateBuildConfiguration": "interactive",
            },
            "import": {
              "maven": {
                "enabled": true,
              },
              "exclusions": [
                "**/node_modules/**",
                "**/.metadata/**",
                "**/archetype-resources/**",
                "**/META-INF/maven/**",
                "/**/test/**",
              ],
            },
            "jdt": {
              "ls": {
                "lombokSupport": {
                  "enabled": true,
                },
              },
            },
            "referencesCodeLens": {
              "enabled": true,
            },
            "implementationsCodeLens": {
              "enabled": true,
            },
            "format": {
              "enabled": true,
            },
            "completion": {
              "favoriteStaticMembers": [
                "org.junit.Assert.*",
                "org.junit.Assume.*",
                "org.junit.jupiter.api.Assertions.*",
                "org.junit.jupiter.api.Assumptions.*",
                "org.junit.jupiter.api.DynamicContainer.*",
                "org.junit.jupiter.api.DynamicTest.*",
              ],
              "importOrder": ["java", "javax", "com", "org"],
            },
          },
        },
      },
    },
  },
}
