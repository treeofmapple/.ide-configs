[
  {
    "label": "Start lazygit",
    "command": "lazygit -p $ZED_WORKTREE_ROOT",
  },
  {
    "label": "Echo: current file's path",
    "command": "echo $ZED_FILE",
    "tags": ["rust-test"],
  },
  {
    "label": "Cargo: Run (Debug)",
    "command": "cargo",
    "args": ["run"],
    "use_new_terminal": true,
  },
  {
    "label": "Cargo: Run (Release)",
    "command": "cargo",
    "args": ["run", "--release"],
  },
  {
    "label": "Java: Run Current File",
    "command": "java",
    "args": ["$ZED_FILE"],
    "use_new_terminal": true,
    "context": {
      "language": "Java",
    },
  },
]
